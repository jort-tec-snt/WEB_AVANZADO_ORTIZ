<%- include('../partials/head') %>

<div class="container auth-container">
  <div class="row">
    <div class="col s12 m8 offset-m2 l6 offset-l3">
      <div class="card auth-card">
        <div class="card-content">
          <h4 class="center-align auth-title">Iniciar sesión</h4>
          <p class="center-align grey-text text-darken-1 auth-subtitle">Accede a tu cuenta</p>

          <div id="message" class="auth-message"></div>

          <form id="signInForm" method="post" action="/api/auth/signIn" novalidate>
            <div class="input-field">
              <i class="material-icons prefix">email</i>
              <input id="email" type="email" name="email" required class="validate">
              <label for="email">Correo electrónico</label>
            </div>

            <div class="input-field">
              <i class="material-icons prefix">lock</i>
              <input id="password" type="password" name="password" required class="validate">
              <label for="password">Contraseña</label>
            </div>

            <div class="center-align action-container">
              <button class="btn waves-effect waves-light btn-large btn-block blue darken-2" type="submit">
                Iniciar sesión
                <i class="material-icons right">login</i>
              </button>
            </div>
          </form>
        </div>
        <div class="card-action center-align">
          <a href="/signUp" class="blue-text text-darken-2">¿No tienes una cuenta? Regístrate</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
