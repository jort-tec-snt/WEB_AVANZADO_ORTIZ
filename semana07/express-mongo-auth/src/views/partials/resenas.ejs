<% const admin = typeof isAdmin !== 'undefined' && isAdmin; %>
<section class="reel-catalog" id="resenas" aria-label="Catálogo de reseñas">
  <h5 class="env-title">Archivo // Reseñas de cine de terror underground</h5>

  <% if (admin) { %>
  <form id="reviewForm" class="reel-form" novalidate>
    <h6 id="reviewFormTitle" class="env-sub">Nueva reseña</h6>
    <input type="hidden" name="id">
    <div class="reel-form-grid">
      <label>Título <input class="browser-default" name="title" type="text" maxlength="120" required></label>
      <label>Año <input class="browser-default" name="year" type="number" min="1888" max="2100" required></label>
      <label>Duración (min) <input class="browser-default" name="minutes" type="number" min="1" max="999"></label>
      <label>Formato <input class="browser-default" name="format" type="text" maxlength="40" placeholder="35 mm · B/N"></label>
      <label>Etiquetas <input class="browser-default" name="tags" type="text" maxlength="100" placeholder="Gótico // Culto"></label>
      <label>Nota (0-10) <input class="browser-default" name="score" type="number" min="0" max="10"></label>
    </div>
    <label>Reseña <textarea class="browser-default" name="text" rows="4" maxlength="2000" required></textarea></label>
    <label>Carátula (JPEG, PNG o WebP; se reduce a 800 px) <input class="browser-default" name="image" type="file" accept="image/jpeg,image/png,image/webp"></label>
    <label class="reel-check" id="removeImageRow" hidden><input type="checkbox" name="removeImage"> Quitar la carátula actual</label>
    <div class="reel-form-actions">
      <button class="btn" type="submit">Guardar reseña</button>
      <button class="btn" type="button" id="cancelEdit" hidden>Cancelar edición</button>
    </div>
  </form>
  <% } %>

  <p id="reviewMessage" role="status"></p>
  <div class="reel-grid" id="reviewsGrid" data-admin="<%= admin %>"></div>
</section>
<script src="/js/reviews.js"></script>
