# Supabase > Connect > ORMs/Connection String > Session pooler (compatible con IPv4)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub > Settings > Developer settings > OAuth Apps
GITHUB_ID=""
GITHUB_SECRET=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""
